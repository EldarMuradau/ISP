<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ipr1.Pages.IntegralPage"
             Title="ProgresDemo">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        <Label x:Name="StatusLabel"
               Grid.Row="0"
               Text="Welcome to .NET MAUI!"
               HorizontalOptions="Center" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
            <ProgressBar x:Name="Progress" Grid.Column="0" Progress="0" ProgressColor="{StaticResource Primary}" />
            <Label x:Name="PercentLabel" Grid.Column="1" Text="0%" WidthRequest="45" />
        </Grid>

        <HorizontalStackLayout Grid.Row="2" Spacing="30" HorizontalOptions="Center" Margin="0,0,0,10">
            <Button x:Name="StartButton" Text="Start" WidthRequest="90" Clicked="OnStartClicked" />
            <Button x:Name="CancelButton" Text="Cancel" WidthRequest="90" Clicked="OnCancelClicked" IsEnabled="False" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
